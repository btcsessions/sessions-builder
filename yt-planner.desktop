[Desktop Entry]
Name=YT Planner
Comment=YouTube Video Planning App
Exec=bash -c 'DIR="$(dirname "$(readlink -f "%k")")" && cd "$DIR" && source venv/bin/activate 2>/dev/null && python app.py & sleep 3 && xdg-open http://127.0.0.1:5000'
Terminal=false
Type=Application
Categories=Utility;
StartupNotify=true
